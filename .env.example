# AI-Guide 环境变量示例 —— 复制为 .env 后填写真实值，.env 永远不要提交。
# 这里只写变量名和说明，不包含任何真实密钥。

# ---- 运行环境 ----
APP_ENV=local                     # local | test | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# uvicorn 监听地址（实际绑定由启动命令决定）
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- 基础设施（必填）----
# MySQL 是唯一事实来源；没有 DATABASE_URL 应用会以“缺少配置”退出，且只显示变量名。
DATABASE_URL=mysql+pymysql://ai_guide:CHANGE_ME@127.0.0.1:3306/ai_guide?charset=utf8mb4
# 老版本 Redis（5.x/6.x，含 Windows 移植版）需在 URL 上加 ?protocol=2；
# redis-py 6+ 默认 RESP3（HELLO 3），只有 Redis 6+ 才支持。生产用的 redis:7.4 两者皆可。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_NAME=ai_guide_runs

# ---- 匿名会话（必填）----
# 用于签名 HttpOnly Cookie，必须是随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_RANDOM_48_BYTES
SESSION_COOKIE_NAME=ai_guide_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SAMESITE=lax
# 生产环境默认 Secure=true；本机 http 调试时可显式设为 false。
SESSION_COOKIE_SECURE=false

# ---- 图片存储与限制 ----
MEDIA_ROOT=backend/var/media
MEDIA_MAX_BYTES=8388608           # 单文件 8MB
MEDIA_MAX_PER_PROJECT=3
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp

# ---- Provider 模式 ----
# mock 只能用于本地和自动测试（fixture 结果带 [FIXTURE] 标记）；生产必须 real。
PROVIDER_MODE=mock
PROVIDER_TIMEOUT_SECONDS=45

# ---- 真实 Provider（PROVIDER_MODE=real 时必填）----
# 也可以填业务空间专属地址：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VISION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
# 项目使用的视觉模型；部署前确认自己的账号、区域和接口支持该模型。
VISION_MODEL=qwen3.8-flash
TEXT_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_API_KEY=
# 文本模型可以与视觉模型不同；换模型后验证 JSON、thinking 参数和预算。
TEXT_MODEL=qwen3.7-plus
TEXT_MODEL_PROFILES=[]
TEXT_THINKING_MODE=auto
VISION_THINKING_MODE=auto
PLACE_API_BASE_URL=https://restapi.amap.com
PLACE_API_KEY=

# ---- 混合思考模型与视觉分辨率（仅对 qwen3.5~3.8 / qwen3-vl-* 生效）----
# 这些系列默认开启思考模式；结构化抽取不需要思考，默认关闭以降低延迟与输出 token。
VISION_ENABLE_THINKING=false
TEXT_ENABLE_THINKING=false
THINKING_BUDGET=4096
# 打开后按固定高分辨率策略处理（忽略 MAX_PIXELS），适合识别招牌/小字；会显著增加视觉 token。
VISION_HIGH_RESOLUTION_IMAGES=false
# 0 表示不发送该参数，沿用服务端默认（2621440）；上限 16777216。
VISION_MAX_PIXELS=0

# ---- Agent 预算与租约 ----
RUN_MAX_STEPS=12
RUN_MAX_TOOL_CALLS=6
RUN_MAX_TOKENS=12000
RUN_MAX_COST=0.50                  # 单次运行的费用上限（元，DECIMAL(12,6)）
RUN_LEASE_SECONDS=120
RUN_STEP_MAX_ATTEMPTS=2
RUN_JSON_REPAIR_ATTEMPTS=2
# 单价用于运行费用预算，单位与厂商账单一致（人民币元/千 token）。
# 下列值是项目预算配置，不代表供应商最新报价；换模型或计价档位后同步更新。
MODEL_PROMPT_PRICE_PER_1K=0.0008
MODEL_COMPLETION_PRICE_PER_1K=0.0027
PLACE_CALL_PRICE=0                # 每次地点检索的计价（元）
# 按角色区分的模型单价（元/千 token）；换模型时必须同步，否则费用预算判断失真。
VISION_PROMPT_PRICE_PER_1K=0.0008
VISION_COMPLETION_PRICE_PER_1K=0.0027
TEXT_PROMPT_PRICE_PER_1K=0.002
TEXT_COMPLETION_PRICE_PER_1K=0.008
# 金额币种与计价口径版本；口径变化时必须递增 PRICE_VERSION，历史调用保留旧版本号。
COST_CURRENCY=CNY
PRICE_VERSION=v1
# 每次模型调用前的预算预留（token）：预留是防超额的近似，最终以结算为准。
RUN_RESERVE_TOKENS_PER_CALL=2000

# ---- 公开 Demo 额度（B6：数据库额度桶，按日原子扣减）----
DEMO_SESSION_RUN_LIMIT=6          # 单个匿名会话每天能发起的运行数
DEMO_DAILY_RUN_LIMIT=200          # 全站每天总运行数
DEMO_IP_DAILY_LIMIT=40            # 单 IP 每天运行数（按不可逆哈希计数）
# 只有直连对端在这个列表里时，才采用 X-Forwarded-For 的第一段：
# 生产若前面有反向代理/负载均衡，必须填代理的 IP（逗号分隔），否则公网访客可伪造来源绕过限流。
TRUSTED_PROXY_IPS=

# ---- SSE ----
SSE_HEARTBEAT_SECONDS=15
SSE_POLL_INTERVAL_SECONDS=0.5
SSE_MAX_STREAM_SECONDS=900

# ---- 其他 ----
# 同源部署时留空；只有前后端分域时才填写允许的来源
ALLOWED_ORIGINS=
WORKER_RECOVERY_INTERVAL_SECONDS=60
# 仅自动测试使用：为 fixture Provider 注入故障，例如 place=timeout,text=invalid_json
FIXTURE_BEHAVIORS=

# ---- 高德地点检索与算路（后端）----
# 一次地点搜索取回多少候选（B4：用于同名/跨城消歧），1–20
PLACE_SEARCH_LIMIT=5
# 驾车算路策略（高德 strategy），0 = 速度优先
ROUTE_DRIVING_STRATEGY=0

# ---- 高德 JS API 2.0（构建期注入前端）----
# 网页端 JS Key：会进入浏览器包，必须在高德控制台按来源域名限制；构建镜像时传给 web 服务
VITE_AMAP_JS_KEY=
# JS 安全密钥：只在服务端，由 /_AMapService 代理追加（禁止放进前端）
AMAP_JS_SECURITY_CODE=
# 服务端 /_AMapService 代理：白名单主机、路径前缀、超时（协议仅测试用，生产保持 https）
AMAP_JS_PROXY_HOSTS=restapi.amap.com,webapi.amap.com,vdata.amap.com
AMAP_JS_PROXY_PATH=/_AMapService
AMAP_JS_PROXY_TIMEOUT_SECONDS=10
# AMAP_JS_PROXY_SCHEME=https   # 仅本地协议桩测试时才改成 http

# ---- D2 账户体系 ----
# 特性开关：false 时认证接口返回 503 auth_disabled（不删除既有账号与数据）
AUTH_ENABLED=true
# 登录 Cookie：本地 http 开发需要 false；生产会被强制为 true（Secure 不能关）
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=ai_guide_auth
AUTH_SESSION_DAYS=30
AUTH_TOKEN_TTL_MINUTES=60
# Argon2id 参数（OWASP 建议档：19 MiB / 2 次 / 1 并行）；调整后旧哈希仍可校验
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
# 认证接口限流（按 IP+邮箱，窗口 15 分钟）
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_ATTEMPT_LIMIT=10
AUTH_REGISTER_ATTEMPT_LIMIT=5
AUTH_EMAIL_ATTEMPT_LIMIT=5
# 邮件：console=只写日志（本地开发，不联网）；smtp=真实发信
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.invalid
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
# 仅本地开发：把邮件正文追加写入该文件，便于取出验证/重置令牌（生产留空）
EMAIL_DUMP_PATH=
# 邮件里的链接前缀（生产填真实域名，必须与站点实际访问地址一致）
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---- TLS 终止（B8）----
# 两种方式必须显式选一种，不能既关闭自动 HTTPS 又用 Secure Cookie：
#   A. Caddy 自己申请证书（推荐）：SITE_ADDRESS=guide.example.com（80 与 443 都要对外可达）
#   B. 外层网关终止 TLS：SITE_ADDRESS=:80，且外层必须设置 X-Forwarded-Proto: https
SITE_ADDRESS=:80
# 对外 HTTP/HTTPS 端口映射；外层网关已有 443 时把 WEB_HTTPS_PORT 留空以关闭该映射
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
