# AI-Guide v0.1 生产环境变量模板（占位符，不含任何真实值）
#
# 使用方式（只在服务器上执行）：
#   cp deploy/.env.production.example .env      # 仓库根目录的 .env
#   vi .env                                     # 填写真实值
#   docker compose up -d
#
# 安全约定：
#   - 生产 .env 只保存在服务器上，不进 Git、不进镜像、不进日志。仓库根 .gitignore 已忽略 .env 与 .env.*。
#   - 变量名与根目录 .env.example 保持一致；本文件额外包含 Compose 需要的 MYSQL_*、IMAGE_REGISTRY、
#     WEB_HTTP_PORT 等部署项（这些变量应用本身不读取）。
#   - 值一律写成占位符 <...>，不要把真实密钥写进本文件。
#   - 生产环境 PROVIDER_MODE 必须为 real；mock 只允许 local/test，否则 API 启动即失败。

# ---- 运行环境 ----
APP_ENV=production                 # local | test | production
APP_VERSION=0.1.0                  # 本地构建的版本标签；更新时更换标签便于回退
LOG_LEVEL=INFO

# ---- Compose 部署项（应用不读取，仅 Compose 使用）----
IMAGE_REGISTRY=local              # 从源码构建；若使用镜像仓库，填写自己的仓库前缀

# ---- MySQL 容器（Compose 使用；DATABASE_URL 必须指向服务名 mysql）----
MYSQL_DATABASE=<db_name>           # 例如 ai_guide
MYSQL_USER=<db_user>               # 例如 ai_guide
MYSQL_PASSWORD=<change_me_db_password>
MYSQL_ROOT_PASSWORD=<change_me_root_password>

# ---- 基础设施（必填）----
# MySQL 是唯一事实来源；缺失时应用启动失败，且错误只显示变量名，不显示值。
DATABASE_URL=mysql+pymysql://<db_user>:<change_me_db_password>@mysql:3306/<db_name>?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=ai_guide_runs

# ---- 匿名会话（必填）----
# 随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=<change_me_random_48_bytes>
SESSION_COOKIE_NAME=ai_guide_session
SESSION_TTL_SECONDS=604800
# 生产使用 HTTPS；不要关闭 Secure Cookie。

# ---- 图片存储与限制 ----
# 容器内 MEDIA_ROOT 由 docker-compose.yml 固定为 /var/lib/ai-guide/media（命名卷 media-data）。
MEDIA_ROOT=/var/lib/ai-guide/media
MEDIA_MAX_BYTES=8388608            # 单文件 8MB
MEDIA_MAX_PER_PROJECT=3
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp

# ---- Provider 模式 ----
# 生产必须 real；mock（fixture）只允许 local/test。
PROVIDER_MODE=real
PROVIDER_TIMEOUT_SECONDS=45

# ---- 真实 Provider（PROVIDER_MODE=real 时必填，缺失时启动失败且只报变量名）----
VISION_API_BASE_URL=<change_me_vision_base_url>
VISION_API_KEY=<change_me_vision_api_key>
VISION_MODEL=qwen3.8-flash
VISION_ENABLE_THINKING=false
TEXT_ENABLE_THINKING=false
THINKING_BUDGET=4096
VISION_HIGH_RESOLUTION_IMAGES=false
VISION_MAX_PIXELS=0
TEXT_API_BASE_URL=<change_me_text_base_url>
TEXT_API_KEY=<change_me_text_api_key>
TEXT_MODEL=qwen3.7-plus
PLACE_API_BASE_URL=<change_me_place_base_url>
PLACE_API_KEY=<change_me_place_api_key>

# ---- Agent 预算与租约 ----
RUN_MAX_STEPS=12
RUN_MAX_TOOL_CALLS=6
RUN_MAX_TOKENS=12000
RUN_MAX_COST=0.50
# 预算预留：每次模型调用前先预留的 token 数（防超额的近似）
RUN_RESERVE_TOKENS_PER_CALL=2000
RUN_LEASE_SECONDS=120
RUN_STEP_MAX_ATTEMPTS=2
RUN_JSON_REPAIR_ATTEMPTS=2
# 单价（元/千 token），换模型时必须同步，否则运行费用预算判断失真
MODEL_PROMPT_PRICE_PER_1K=0
MODEL_COMPLETION_PRICE_PER_1K=0
VISION_PROMPT_PRICE_PER_1K=0.0008
VISION_COMPLETION_PRICE_PER_1K=0.0027
TEXT_PROMPT_PRICE_PER_1K=0.002
TEXT_COMPLETION_PRICE_PER_1K=0.008
PLACE_CALL_PRICE=0
# 币种与计价口径版本；口径变化必须递增版本号
COST_CURRENCY=CNY
PRICE_VERSION=v1

# ---- 公开 Demo 额度（数据库额度桶，按日原子扣减）----
DEMO_SESSION_RUN_LIMIT=6
DEMO_DAILY_RUN_LIMIT=200
DEMO_IP_DAILY_LIMIT=40
# 只有直连对端在该列表里时才信任 X-Forwarded-For 的第一段；
# 生产前面有反向代理/负载均衡时必须填代理 IP（逗号分隔），否则公网可伪造来源绕过限流。
TRUSTED_PROXY_IPS=

# ---- 高德地点检索与算路（后端）----
# 一次地点搜索取回多少候选（用于同名/跨城消歧），1–20
PLACE_SEARCH_LIMIT=5
# 驾车算路策略（高德 strategy），0 = 速度优先
ROUTE_DRIVING_STRATEGY=0
# /_AMapService 代理白名单（协议仅本地协议桩测试才改为 http）
AMAP_JS_PROXY_HOSTS=restapi.amap.com,webapi.amap.com,vdata.amap.com
AMAP_JS_PROXY_PATH=/_AMapService
AMAP_JS_PROXY_TIMEOUT_SECONDS=10

# ---- SSE ----
SSE_HEARTBEAT_SECONDS=15
SSE_POLL_INTERVAL_SECONDS=0.5
SSE_MAX_STREAM_SECONDS=900

# ---- 监听地址与 Cookie（容器内由 Compose 覆盖）----
APP_HOST=0.0.0.0
APP_PORT=8000
SESSION_COOKIE_SAMESITE=lax
# 生产必须为 true（Secure Cookie）；用 http 直连访问时不会维持会话
SESSION_COOKIE_SECURE=true

# ---- 其他 ----
# 同源部署时留空；只有前后端分域时才填写允许的来源
ALLOWED_ORIGINS=
WORKER_RECOVERY_INTERVAL_SECONDS=60
# 生产必须留空：fixture 故障注入只用于自动测试
FIXTURE_BEHAVIORS=

# ---- 备份/回退脚本（deploy/*.sh，可选；不设置时使用脚本内置默认值）----
# BACKUP_RETENTION=7               # backup.sh 保留最近 N 份
# BACKUP_DIR=/opt/ai-guide/backups # 备份目录，默认 <仓库根>/backups

# ---- 高德 JS API 2.0（构建期注入前端）----
# 网页端 JS Key：会进入浏览器包，必须在高德控制台按来源域名限制；构建镜像时传给 web 服务
VITE_AMAP_JS_KEY=
# JS 安全密钥：只在服务端，由 /_AMapService 代理追加（禁止放进前端）
AMAP_JS_SECURITY_CODE=

# ---- D2 账户体系 ----
# 特性开关：false 时认证接口返回 503 auth_disabled（不删除既有账号与数据）
AUTH_ENABLED=true
# 登录 Cookie：本地 http 开发需要 false；生产会被强制为 true（Secure 不能关）
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAME=ai_guide_auth
AUTH_SESSION_DAYS=30
AUTH_TOKEN_TTL_MINUTES=60
# Argon2id 参数（OWASP 建议档：19 MiB / 2 次 / 1 并行）；调整后旧哈希仍可校验
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
# 认证接口限流（按 IP+邮箱，窗口 15 分钟）
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_ATTEMPT_LIMIT=10
AUTH_REGISTER_ATTEMPT_LIMIT=5
AUTH_EMAIL_ATTEMPT_LIMIT=5
# 邮件：console=只写日志（本地开发，不联网）；smtp=真实发信
EMAIL_BACKEND=smtp
EMAIL_FROM=no-reply@example.invalid
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
# 仅本地开发：把邮件正文追加写入该文件，便于取出验证/重置令牌（生产留空）
EMAIL_DUMP_PATH=
# 邮件里的链接前缀（生产填真实域名，必须与站点实际访问地址一致）
PUBLIC_BASE_URL=https://guide.example.com

# ---- TLS 终止（B8）----
# 两种方式必须显式选一种，不能既关闭自动 HTTPS 又用 Secure Cookie：
#   A. Caddy 自己申请证书（推荐）：SITE_ADDRESS=guide.example.com（80 与 443 都要对外可达）
#   B. 外层网关终止 TLS：SITE_ADDRESS=:80，且外层必须设置 X-Forwarded-Proto: https
SITE_ADDRESS=guide.example.com
# 对外 HTTP/HTTPS 端口映射；本模板由 Caddy 直接提供 HTTPS。
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ---- TLS 与 Cookie 的对应关系（B8 必读）----
# 登录 Cookie（AUTH_COOKIE_SECURE）与访客 Cookie 在生产环境都是 Secure：
#   * 方式 A（SITE_ADDRESS=域名，Caddy 自动签发证书）：浏览器用 https 访问，Cookie 正常。
#   * 方式 B（SITE_ADDRESS=:80，外层网关终止 TLS）：外层必须设置
#       X-Forwarded-Proto: https
#     并且用户必须通过 https 访问；否则浏览器不会回传 Secure Cookie，
#     表现为"登录后立刻又变成未登录 / 每次刷新都新建访客"。
# 证书持久化在 caddy-data 卷；删除该卷会导致重新申请证书（可能触发 ACME 速率限制）。
